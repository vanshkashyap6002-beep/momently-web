# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/momently?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string" # generate: openssl rand -base64 32

# Supabase Storage (media storage — see lib/supabase-storage.ts)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key" # server-only, never expose to the client

# Razorpay (payments — see lib/razorpay.ts)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret" # set when configuring the webhook in the Razorpay Dashboard

# Optional — shared rate limiting across multiple server instances (see
# lib/rate-limit.ts). Leave unset for local dev / single-instance
# deployments; it falls back to an in-memory limiter automatically.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional — protects the maintenance endpoint that expires stale pending
# payments (see app/api/cron/expire-payments/route.ts).
CRON_SECRET="replace-with-a-long-random-string"
